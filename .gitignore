# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
# Backups of a real .env carry the same live tokens the original does — a
# dated copy left in the tree must never become a commit.
.env.*
!.env.example
# Real MCP token files (keep mcp-tokens.example.txt tracked, ignore actual secrets)
mcp-tokens.txt
*.tokens

# Generated robot descriptors (source of truth is each plugin's metadata(); these bake
# in a deployment-specific ngrok domain — regenerate with scripts/export_descriptor.py)
robot-descriptors/

# LeLab's built UI bundle (regenerate with scripts/build_lelab_ui.sh — never vendored)
src/plugins/lelab_so101/ui_dist/
